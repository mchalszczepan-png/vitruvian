{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:vitruvian:referral-template:colorectal:v1",
 "title": "Colorectal Referral template",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "patientId",
  "age",
  "sex",
  "smokingStatus",
  "mainSymptom",
  "symptomDurationWeeks",
  "symptomVisitCount",
  "examFindings",
  "generalCondition",
  "testsDone",
  "currentMedicines",
  "otherIllnesses",
  "suspectedDiagnosis",
  "suspectedCancerType",
  "gpQuestion",
  "urgency",
  "referralDate",
  "referringGpId",
  "bowelHabitChange",
  "rectalBleeding",
  "abdominalMass",
  "ironDeficiencyAnaemia",
  "fitDone"
 ],
 "properties": {
  "patientId": {
   "type": "string",
   "pattern": "^SYN-[0-9]{3}$",
   "description": "Made-up demo ID only."
  },
  "age": {
   "type": "integer",
   "minimum": 0,
   "maximum": 120
  },
  "sex": {
   "type": "string",
   "enum": [
    "female",
    "male",
    "other",
    "unknown"
   ]
  },
  "smokingStatus": {
   "type": "string",
   "enum": [
    "never",
    "former",
    "current",
    "unknown"
   ]
  },
  "packYears": {
   "type": "number",
   "minimum": 0
  },
  "mainSymptom": {
   "type": "string",
   "minLength": 1
  },
  "symptomDurationWeeks": {
   "type": "integer",
   "minimum": 0
  },
  "symptomVisitCount": {
   "type": "integer",
   "minimum": 0
  },
  "examFindings": {
   "type": "string",
   "minLength": 1
  },
  "generalCondition": {
   "type": "string",
   "minLength": 1
  },
  "weightLossKg": {
   "type": "number",
   "minimum": 0
  },
  "testsDone": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "result"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "date": {
      "type": "string",
      "format": "date"
     },
     "result": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "currentMedicines": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "otherIllnesses": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "priorCancer": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "type",
    "yearDiagnosed",
    "treatment"
   ],
   "properties": {
    "type": {
     "type": "string"
    },
    "yearDiagnosed": {
     "type": "integer"
    },
    "treatment": {
     "type": "string"
    }
   }
  },
  "suspectedDiagnosis": {
   "type": "string",
   "minLength": 1
  },
  "suspectedCancerType": {
   "const": "colorectal"
  },
  "gpQuestion": {
   "type": "string",
   "minLength": 1
  },
  "urgency": {
   "type": "string",
   "enum": [
    "urgent_2_week",
    "urgent"
   ]
  },
  "referralDate": {
   "type": "string",
   "format": "date"
  },
  "referringGpId": {
   "type": "string",
   "minLength": 1
  },
  "matchedRuleIds": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "riskGradientAiEstimate": {
   "type": "integer",
   "minimum": 0,
   "maximum": 10
  },
  "bowelHabitChange": {
   "type": "boolean"
  },
  "rectalBleeding": {
   "type": "boolean"
  },
  "abdominalMass": {
   "type": "boolean"
  },
  "ironDeficiencyAnaemia": {
   "type": "boolean"
  },
  "haemoglobinGPerL": {
   "type": "number",
   "minimum": 0
  },
  "fitDone": {
   "type": "boolean"
  },
  "fitValueUgHbPerG": {
   "type": "number",
   "minimum": 0
  },
  "rectalExamResult": {
   "type": "string",
   "enum": [
    "normal",
    "abnormal",
    "not_done"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "fitDone": {
      "const": true
     }
    },
    "required": [
     "fitDone"
    ]
   },
   "then": {
    "required": [
     "fitValueUgHbPerG"
    ]
   }
  }
 ]
}